<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
    <layer-list>
        <!-- Outer border layer -->
        <item>
            <shape android:layout_width="match_parent" android:layout_height="match_parent" android:shape="oval">
                <solid android:color="@android:color/white" />
                <stroke android:width="4dp" android:color="@android:color/white" />
            </shape>
        </item>

        <!-- Inner FAB color layer -->
        <item
            android:left="50dp"
            android:right="50dp"
            android:top="50dp"
            android:bottom="50dp">
            <shape android:shape="oval">
                <solid android:color="@color/red" /> <!-- Set the inner FAB color to red -->
            </shape>
        </item>
    </layer-list>
    </item>
</selector>